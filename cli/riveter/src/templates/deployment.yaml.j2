{% import "_macros.yaml.j2" as m %}
{#
  `container_name` and `service_account` keep the defaults this template shipped
  with, so migrating to the shared macros does not silently rename containers or
  drop the service account on existing deployments.
#}
{% set defaults = {
  "container_name": "ossiriand",
  "service_account": "ossiriand-" ~ env ~ "-sa",
  "pull_policy": "Always"
} %}
apiVersion: apps/v1
kind: Deployment
{{ m.metadata(res, env, res.namespace | default(data.namespace_name), none) }}
spec:
  replicas: {{ res.replicas | default(1) }}
{% if res.revision_history_limit is defined %}
  revisionHistoryLimit: {{ res.revision_history_limit }}
{% endif %}
{% if res.min_ready_seconds is defined %}
  minReadySeconds: {{ res.min_ready_seconds }}
{% endif %}
{% if res.strategy %}
  strategy:
    type: {{ res.strategy.type | default("RollingUpdate") }}
{% if res.strategy.max_surge is defined or res.strategy.max_unavailable is defined %}
    rollingUpdate:
{% if res.strategy.max_surge is defined %}
      maxSurge: {{ res.strategy.max_surge }}
{% endif %}
{% if res.strategy.max_unavailable is defined %}
      maxUnavailable: {{ res.strategy.max_unavailable }}
{% endif %}
{% endif %}
{% endif %}
  selector:
    matchLabels:
{{ m.match_labels(res, env) | indent(6, true) }}
  template:
{{ m.pod_template(res, env, defaults) | indent(4, true) }}

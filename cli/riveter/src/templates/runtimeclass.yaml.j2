{% import "_macros.yaml.j2" as m %}
apiVersion: node.k8s.io/v1
kind: RuntimeClass
{{ m.metadata(res, env, none, none) }}
handler: {{ res.handler }}
{% if res.overhead %}
overhead:
  podFixed:
{% for k, v in res.overhead | dictsort %}
    {{ k }}: "{{ v }}"
{% endfor %}
{% endif %}
{% if res.node_selector %}
scheduling:
  nodeSelector:
{% for k, v in res.node_selector | dictsort %}
    {{ k }}: "{{ v }}"
{% endfor %}
{% if res.tolerations %}
  tolerations:
{{ res.tolerations | to_yaml | indent(2, true) }}
{% endif %}
{% endif %}

apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ res.name }}
  namespace: {{ data.namespace_name }}
  labels:
    app.kubernetes.io/name: {{ res.app_name | default(res.name) }}
    app.kubernetes.io/instance: {{ res.instance | default(res.name) }}
    app.kubernetes.io/managed-by: riveter
    env: {{ env }}
data:
{% for key in res.data %}
{% if "\n" in res.data[key] %}
  {{ key }}: |
    {{ res.data[key] | indent(4) }}
{% else %}
  {{ key }}: '{{ res.data[key] | replace("'", "''") }}'
{% endif %}
{% endfor %}

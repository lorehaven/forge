{% import "_macros.yaml.j2" as m %}
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
{{ m.metadata(res, env, none, none) }}
spec:
  group: {{ res.group }}
  scope: {{ res.scope | default("Namespaced") }}
  names:
    kind: {{ res.names.kind }}
    plural: {{ res.names.plural }}
{% if res.names.singular is defined %}
    singular: {{ res.names.singular }}
{% endif %}
{% if res.names.list_kind is defined %}
    listKind: {{ res.names.list_kind }}
{% endif %}
{% if res.names.short_names %}
    shortNames:
{% for s in res.names.short_names %}
      - {{ s }}
{% endfor %}
{% endif %}
{% if res.names.categories %}
    categories:
{% for c in res.names.categories %}
      - {{ c }}
{% endfor %}
{% endif %}
  versions:
{{ res.versions | to_yaml | indent(4, true) }}
{% if res.conversion %}
  conversion:
{{ res.conversion | to_yaml | indent(4, true) }}
{% endif %}

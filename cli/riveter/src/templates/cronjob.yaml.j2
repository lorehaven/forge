{% import "_macros.yaml.j2" as m %}
{#
  `pull_policy`, `restart_policy` and `host_path_type` keep the defaults this
  template shipped with — note `host_path_type` was empty here, not `File` as
  in job.yaml.j2. The pod template only grows a `metadata` block when the
  overlay asks for one.
#}
{% set defaults = {
  "pull_policy": "Always",
  "restart_policy": "OnFailure",
  "host_path_type": ""
} %}
apiVersion: batch/v1
kind: CronJob
{{ m.metadata(res, env, res.namespace | default(data.namespace_name), none) }}
spec:
  schedule: "{{ res.schedule }}"
{% if res.time_zone is defined %}
  timeZone: {{ res.time_zone }}
{% endif %}
{% if res.concurrency_policy is defined %}
  concurrencyPolicy: {{ res.concurrency_policy }}
{% endif %}
{% if res.starting_deadline_seconds is defined %}
  startingDeadlineSeconds: {{ res.starting_deadline_seconds }}
{% endif %}
{% if res.suspend is defined %}
  suspend: {{ res.suspend }}
{% endif %}
  successfulJobsHistoryLimit: {{ res.successful_jobs_history | default(3) }}
  failedJobsHistoryLimit: {{ res.failed_jobs_history | default(1) }}
  jobTemplate:
    spec:
{% if res.backoff_limit is defined %}
      backoffLimit: {{ res.backoff_limit }}
{% endif %}
{% if res.ttl_seconds_after_finished is defined %}
      ttlSecondsAfterFinished: {{ res.ttl_seconds_after_finished }}
{% endif %}
      template:
{% if res.pod_labels or res.pod_annotations %}
{{ m.pod_template(res, env, defaults) | indent(8, true) }}
{% else %}
        spec:
{{ m.pod_spec(res, env, defaults) | indent(10, true) }}
{% endif %}

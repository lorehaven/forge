BASE_PATH=/conveyor
SERVER_ADDR="0.0.0.0:9443"
SERVER_HTTP_REDIRECT_ADDR="0.0.0.0:9080"

SERVICE_REALM="https://registry.local:9443/token"
SERVICE_NAME="conveyor"

SERVICE_AUTH_ENABLED=true
SERVICE_USERNAME=admin
SERVICE_PASSWORD=password
LOG_SKIP_PREFIXES=/conveyor/ui

# This service's own OAuth client identity toward gatehouse - see
# docker/gatehouse-service/config/clients.toml.
GATEHOUSE_CLIENT_SECRET="forge-local-dev-secret-conveyor"
GATEHOUSE_TLS_VERIFY=false

DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
DB_SCHEMA="conveyor"
DB_POOL_MAX_SIZE=5

# ── Execution ────────────────────────────────────────────────────────────────

# native | kubernetes | mock
CONVEYOR_EXECUTOR=native

# Root for per-run checkouts; each run gets a directory beneath it, removed
# when the run finishes.
CONVEYOR_WORK_DIR=/tmp/conveyor

# Runs this replica executes at once. One repository never has two runs in
# flight regardless of this value.
CONVEYOR_MAX_CONCURRENT_RUNS=2

# Ceiling on a job that does not set its own timeout.
CONVEYOR_JOB_TIMEOUT_SECS=3600

# Ceiling on the checkout. A fetch that hangs - an unreachable host, or a
# credential prompt on a server with no terminal to answer it - would otherwise
# hold a worker until the process is restarted.
CONVEYOR_CHECKOUT_TIMEOUT_SECS=600

# A run whose worker stopped refreshing its claim for this long is considered
# lost and goes back on the queue.
CONVEYOR_CLAIM_STALE_AFTER_SECS=300

# A pull request from a fork carries a pipeline written outside the estate.
# Under the native executor it would run with this service's privileges, so
# leave this off until the kubernetes executor is in use.
CONVEYOR_ALLOW_FORK_PR=false

# 32-byte key, hex or base64, that seals the secret store. Generate with:
#   openssl rand -hex 32
# CONVEYOR_SECRET_KEY=

# ── Front page ───────────────────────────────────────────────────────────────

# How many pipelines the front page shows, and at most how many of those may
# come from the same repository.
CONVEYOR_HOME_RECENT_RUNS=5
CONVEYOR_HOME_MAX_RUNS_PER_REPO=1

# Rows per page on the full pipeline history (/ui/runs).
CONVEYOR_RUNS_PAGE_SIZE=25

# ── Kubernetes executor ──────────────────────────────────────────────────────

# Only read when CONVEYOR_EXECUTOR=kubernetes.
# CONVEYOR_K8S_NAMESPACE=conveyor
# CONVEYOR_K8S_DEFAULT_IMAGE=alpine:3.22
# CONVEYOR_K8S_GIT_IMAGE=alpine/git:latest
# CONVEYOR_K8S_SERVICE_ACCOUNT=conveyor-jobs
# CONVEYOR_K8S_TTL_SECONDS=3600

# ── Artifacts ────────────────────────────────────────────────────────────────

# Where a job's declared `artifacts` are uploaded. Unset means conveyor still
# builds, but says what a job produced rather than keeping it.
# WAREHOUSE_URL=https://registry.local:6443/warehouse
# WAREHOUSE_TECH_USERNAME=service
# WAREHOUSE_TECH_PASSWORD=password
# WAREHOUSE_TLS_VERIFY=false

# Which warehouse file storage they go into.
# CONVEYOR_ARTIFACT_STORAGE=artifacts

# ── Webhooks ─────────────────────────────────────────────────────────────────

# The estate-wide secret deliveries are signed with, used by any repository that
# has no WEBHOOK_SECRET of its own. Without either, the webhook endpoint refuses
# to serve: every delivery would be unverified, which would let anyone on the
# network start a build. Generate with:
#   openssl rand -hex 32
# CONVEYOR_WEBHOOK_SECRET=

# A GitHub token with `repo:status`. Without it conveyor still builds; it just
# cannot put a mark on the commit.
# CONVEYOR_GITHUB_TOKEN=

# For GitHub Enterprise, whose API lives on the installation's own host.
# CONVEYOR_GITHUB_API=https://api.github.com

# The name conveyor's mark appears under, so it does not collide with anyone
# else's check on the same commit.
# CONVEYOR_STATUS_CONTEXT=conveyor

# Where conveyor is reachable from, used to link a status mark back to the run.
# Unset means no link - which beats a link to localhost on somebody else's
# machine.
# CONVEYOR_PUBLIC_URL=https://conveyor.example.com/conveyor

# Logging configuration (RUST_LOG)
# Uncomment one of the below to customize logging. Default is 'info'
# RUST_LOG=conveyor_service=debug                      # Only this service (debug level)
# RUST_LOG=conveyor_service=debug,quench=debug         # Service + quench libraries
# RUST_LOG=debug                                        # All modules (debug level)

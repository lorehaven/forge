# syntax=docker/dockerfile:1.5

# ---------- Dependency build stage ----------
FROM rust:1.94-alpine3.22 AS deps-builder

# Install build dependencies
RUN apk add --no-cache musl-dev pkgconfig build-base ca-certificates git curl openssl

# Add MUSL target
RUN rustup target add x86_64-unknown-linux-musl

# Configure Forge workspace registry aliases used by Cargo manifests.
ARG CARGO_REGISTRIES_ENNOR_INDEX=sparse+https://ennor.ddns.net/index/
ARG CARGO_REGISTRIES_ENNOR_TOKEN=
RUN mkdir -p /usr/local/cargo && \
    printf "[registries.ennor]\nindex = \"%s\"\n" "${CARGO_REGISTRIES_ENNOR_INDEX}" > /usr/local/cargo/config.toml && \
    if [ -n "${CARGO_REGISTRIES_ENNOR_TOKEN}" ]; then \
      printf "token = \"%s\"\n" "${CARGO_REGISTRIES_ENNOR_TOKEN}" >> /usr/local/cargo/config.toml; \
    fi

WORKDIR /usr/src/app

# Copy workspace structure and manifests (minimal layer to trigger on manifest changes)
COPY Cargo.toml Cargo.lock ./
COPY cli ./cli
COPY docker ./docker
COPY examples ./examples
COPY libs ./libs
COPY tests ./tests

# Build all dependencies (cached separately from source changes)
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --target x86_64-unknown-linux-musl --workspace --offline 2>/dev/null || \
    cargo build --release --target x86_64-unknown-linux-musl --workspace

# ---------- Build stage ----------
FROM deps-builder AS builder

# Copy full sources (this layer can be rebuilt without touching dependencies)
COPY . .

# Build with pre-cached dependencies
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release --target x86_64-unknown-linux-musl --workspace

# No strip step here on purpose. `[profile.release] strip = "debuginfo"` in the
# workspace manifest already does it, for local builds as well as this one, so a
# binary built here and one built in an image are the same binary.
#
# There used to be a `strip ./service || true` in the runtime stage below. Bare
# alpine has no binutils, so it failed with "not found" on every build and the
# `|| true` turned that into silence - the images shipped unstripped for as long
# as the line existed.

# ---------- Runtime stage ----------
FROM alpine:3.22

ARG PROJECT_NAME
ENV PROJECT_NAME=${PROJECT_NAME}

ARG RESOURCES_PATH
ENV RESOURCES_PATH=${RESOURCES_PATH}

# The three ways a service is allowed to differ, set per package under
# `build_args` in .anvil.toml. Anything that needs more than these belongs in
# its own Dockerfile - but nothing has yet, and a fork of this file for the sake
# of one line drifts out of step with it the moment this one changes.

# Extra apk packages the runtime needs. Conveyor asks for `git`: it checks out
# the commit before it can read the pipeline that commit declares.
ARG RUNTIME_PACKAGES=""

# What ships beside `config`. Web services carry their translations; foundry is
# a migration job and carries its catalog instead.
ARG RESOURCE_DIR=i18n

# Who the entrypoint runs as. Root is the standing behaviour; a service that has
# been checked against it asks for 999:999, which everything under /app is
# already owned by.
ARG RUN_AS=root

RUN apk add --no-cache ca-certificates ${RUNTIME_PACKAGES}

WORKDIR /app

# Ownership is set as each file is copied. A `RUN chown -R /app` afterwards does
# the same job but writes a whole second copy of everything it touches into its
# own layer - it doubled the binary, about 30MB an image, for a metadata change.
COPY --from=builder --chown=999:999 /usr/src/app/${RESOURCES_PATH}/config ./config
COPY --from=builder --chown=999:999 /usr/src/app/${RESOURCES_PATH}/${RESOURCE_DIR} ./${RESOURCE_DIR}
COPY --from=builder --chown=999:999 /usr/src/app/target/x86_64-unknown-linux-musl/release/${PROJECT_NAME} ./service

USER ${RUN_AS}

EXPOSE 80
ENTRYPOINT ["./service"]

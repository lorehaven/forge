# Shared realm: one signing key so a gatehouse token verifies at every service.
JWT_SECRET=forge-bdd-shared-secret
SERVICE_USERNAME=admin
SERVICE_PASSWORD=password

# Where each service is reachable; ports match src/services.rs.
SAGE_API_URL=https://127.0.0.1:7777
SWITCHBOARD_API_URL=https://127.0.0.1:8554
WAREHOUSE_API_URL=https://127.0.0.1:8443
# gatehouse ships no test certs, so it serves plain HTTP here
GATEHOUSE_API_URL=http://127.0.0.1:5443

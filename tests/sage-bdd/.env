SAGE_API_URL=https://localhost:7777
BASE_PATH=/sage
SERVICE_NAME=sage
SERVICE_AUTH_ENABLED=true
JWT_SECRET=test_secret_key
SERVICE_REALM=https://localhost:7777/token
# Use in-memory database for BDD tests
DATABASE_URL=
POSTGRES_URL=
DB_SCHEMA=test_sage
DB_RECREATE=false
# Mock switchboard service
SWITCHBOARD_URL=https://localhost:8554/switchboard
SWITCHBOARD_TECH_USERNAME=admin
SWITCHBOARD_TECH_PASSWORD=password
SWITCHBOARD_TLS_VERIFY=false
# Search providers
SEARCH_PROVIDER=duckduckgo
# Sage specific
SAGE_CAPABILITY_PROFILE=web_assistant
SAGE_DEFAULT_MODELS=[{\"name\":\"test-model\"}]
SAGE_SUPPORTED_MODELS=*
